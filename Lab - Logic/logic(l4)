initial_state = {
    "At(Robot,A)",
    "At(Package,A)"
}

goal = {
    "At(Package,C)"
}


# -----------------------------------------------------
# Test A: Solvable Problem
# -----------------------------------------------------

actions_test_a = create_warehouse_actions()

run_test(
